{
  "name": "jeremy-challenge-backend",
  "version": "0.1.0",
  "description": "Backend for Challenge Me — Chess matches API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/migrate.js && node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "psql $DATABASE_URL -f migrations/init.sql",
    "migrate:node": "node src/migrate.js",
    "test:flow": "node test/test_flow.js",
    "test:admin": "node test/turn_regression.js && node test/geolocation_regression.js && node test/admin_gameplay_regression.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chess.js": "^1.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "pg": "^8.11.0",
    "uuid": "^9.0.0",
    "express-session": "^1.17.3",
    "bcrypt": "^5.1.0",
    "connect-pg-simple": "^8.0.0",
    "csurf": "^1.11.0"
  }
}
